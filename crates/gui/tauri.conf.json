{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Corpus",
  "version": "0.1.0",
  "identifier": "dev.pxz.corpus",
  "build": {
    "frontendDist": "ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Corpus - RAG Knowledge Base",
        "width": 1320,
        "height": 840,
        "minWidth": 900,
        "minHeight": 560
      }
    ],
    "security": {
      "csp": {
        "default-src": ["'self'"],
        "script-src": ["'self'"],
        "style-src": ["'self'", "'unsafe-inline'"],
        "img-src": ["'self'", "data:"],
        "font-src": ["'self'"],
        "connect-src": ["'self'"]
      }
    }
  },
  "bundle": {
    "active": false
  }
}
