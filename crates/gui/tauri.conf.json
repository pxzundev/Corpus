{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Corpus",
  "version": "0.1.0",
  "identifier": "dev.pxz.corpus",
  "build": {
    "frontendDist": "ui",
    "beforeBuildCommand": "cargo build --release -p corpus-mcp"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Corpus - RAG Knowledge Base",
        "width": 1320,
        "height": 840,
        "minWidth": 900,
        "minHeight": 560
      }
    ],
    "security": {
      "csp": {
        "default-src": ["'self'"],
        "script-src": ["'self'"],
        "style-src": ["'self'", "'unsafe-inline'"],
        "img-src": ["'self'", "data:"],
        "font-src": ["'self'"],
        "connect-src": ["'self'"]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg"],
    "resources": ["resources/corpus-mcp"],
    "icon": [
      "icons/icon.icns",
      "icons/icon.ico",
      "icons/icon.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/32x32.png",
      "icons/64x64.png"
    ]
  }
}
